# OpenTripPlanner Configuration
# Copy this file to .env and customize as needed

# JVM Memory Settings (adjust based on your data size and available RAM)
# This is used by docker-compose.yml to configure the Java heap size
JAVA_OPTS=-Xmx4G

# Examples:
# For 8GB RAM: JAVA_OPTS=-Xmx8G
# For 2GB RAM: JAVA_OPTS=-Xmx2G
